{
  "name": "@mosmox-ui/framework",
  "version": "1.0.0",
  "description": "React UI components for Mosmox UI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mosmox-ui/Framework.git"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build:js && npm run build:types",
    "build:js": "vite build",
    "build:types": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@mosmox-ui/icons": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
